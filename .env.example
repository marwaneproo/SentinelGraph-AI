# SentinelGraph-AI Compose settings.
# start-project.bat replaces generated-secret markers with random local values.
ENVIRONMENT=production
MONGODB_DB_NAME=sentinelgraph_db
NEO4J_PASSWORD=__GENERATE_ON_FIRST_START__
JWT_SECRET=__GENERATE_ON_FIRST_START__
SEED_ADMIN_PASSWORD=__GENERATE_ON_FIRST_START__
SEED_ANALYST_PASSWORD=__GENERATE_ON_FIRST_START__
SEED_VIEWER_PASSWORD=__GENERATE_ON_FIRST_START__
ACCESS_TOKEN_EXPIRE_MINUTES=480
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3:latest
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional host-port overrides
FRONTEND_PORT=3000
BACKEND_PORT=8000
MONGODB_PORT=27017
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
